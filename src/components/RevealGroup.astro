---
type Item = { id: string; title: string; body: string };
interface Props { id: string; title: string; intro?: string; items: readonly Item[]; ordered?: boolean }
const { id, title, intro, items, ordered = false } = Astro.props as Props;
---
<section class="premium-section" id={id} data-completion-id={id} data-required-items={JSON.stringify(items.map((item) => item.id))} data-premium-reveals data-ordered={String(ordered)} aria-labelledby={`${id}-heading`}>
  <div class="container"><div class="premium-section__intro"><h2 id={`${id}-heading`}>{title}</h2>{intro && <p>{intro}</p>}</div><div class="premium-reveals">{items.map((item, index) => <article class="premium-reveal"><h3><button type="button" aria-expanded="false" aria-controls={`${id}-reveal-${index}`} data-reveal-id={item.id} disabled={ordered && index > 0}><span>{item.title}</span><span aria-hidden="true">+</span></button></h3><div class="premium-reveal__body" id={`${id}-reveal-${index}`} hidden><p>{item.body}</p></div></article>)}</div></div>
</section>
<script>
  import { courseStateReady } from "../lib/course-state";
  courseStateReady.then((courseState) => document.querySelectorAll<HTMLElement>("[data-premium-reveals]").forEach((root) => {
    if (root.dataset.ready === "true") return; root.dataset.ready = "true";
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-reveal-id]")];
    if (root.dataset.ordered === "true") {
      const visited = new Set(courseState.explored(root.id));
      buttons.forEach((button, index) => { button.disabled = index > 0 && !visited.has(buttons[index - 1]?.dataset.revealId || ""); });
      window.addEventListener("course-progress:explore-state", ((event: CustomEvent<{ activityId: string; itemIds: string[] }>) => {
        if (event.detail.activityId !== root.id) return;
        const restored = new Set(event.detail.itemIds);
        buttons.forEach((button, index) => { button.disabled = index > 0 && !restored.has(buttons[index - 1]?.dataset.revealId || ""); });
      }) as EventListener);
    }
    buttons.forEach((button, index) => button.addEventListener("click", () => { const open = button.getAttribute("aria-expanded") !== "true"; button.setAttribute("aria-expanded", String(open)); const panel = document.getElementById(button.getAttribute("aria-controls") || ""); if (panel) panel.hidden = !open; const icon = button.querySelector<HTMLElement>("[aria-hidden]"); if (icon) icon.textContent = open ? "−" : "+"; if (open && root.dataset.ordered === "true" && buttons[index + 1]) buttons[index + 1].disabled = false; if (open && button.dataset.revealId) window.dispatchEvent(new CustomEvent("course-progress:explore", { detail: { activityId: root.id, itemId: button.dataset.revealId } })); }));
  }));
</script>
