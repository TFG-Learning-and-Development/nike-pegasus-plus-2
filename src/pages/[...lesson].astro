---
// Existing bookmarks and LMS lesson locations return to the single course page.
export function getStaticPaths() {
  return ["choose-and-practise", "check-and-recommend"].map((lesson) => ({ params: { lesson } }));
}
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><title>Content</title><meta name="robots" content="noindex" /><meta http-equiv="refresh" content="0;url=../" /><script is:inline>window.location.replace(new URL("../", window.location.href));</script></head><body><p><a href="../">Continue to Content</a></p></body></html>
